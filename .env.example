# Public connection settings only. The anon/publishable key is public by design: security relies on Auth and RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Explicit opt-in: fictitious demo profiles stored in this browser only.
VITE_ENABLE_DEMO=true
# Server-side script only (local Supabase); never prefix with VITE_. Never commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Local demo accounts only; choose your own password (12+ characters).
DEMO_PASSWORD=
