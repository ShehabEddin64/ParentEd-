{
  "name": "parented",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run",
    "test": "vitest run",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "format": "prettier --write src tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json wrangler.jsonc",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json wrangler.jsonc",
    "seed:content": "node scripts/build-seed.mjs",
    "sql:bundle": "node scripts/build-seed.mjs && node scripts/bundle-sql.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "supabase": "^2.39.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.35.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
