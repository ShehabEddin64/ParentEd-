{
  "name": "parented",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json",
    "seed:content": "node scripts/build-seed.mjs",
    "check:safety": "node scripts/check-safety.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "ParentEd \u2014 my Muslim Hacks Montr\u00e9al hackathon project. A local-only homeschooling platform demo."
}
